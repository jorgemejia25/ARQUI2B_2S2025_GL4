{
  "ejemplos_respuestas_api": {
    "version": "1.0.0",
    "descripcion": "Ejemplos de respuestas JSON de todos los endpoints de la API IoT",
    "fecha": "2024-01-15",

    "endpoints_principales": {
      "status": {
        "url": "GET /api/v1/status",
        "descripcion": "Estado del sistema y conexión MQTT",
        "ejemplo_respuesta": {
          "mqtt_connected": true,
          "broker": "localhost:1883",
          "topics_count": 1,
          "topics": ["arduino/data"]
        }
      }
    },

    "endpoints_datos": {
      "bus_positions": {
        "url": "GET /api/v1/data/bus-positions",
        "descripcion": "Posiciones de buses",
        "parametros": {
          "bus_id": "opcional - ID del bus",
          "bus_code": "opcional - Código del bus (BUS_TRANSMETRO, BUS_TRANSURBANO)",
          "limit": "opcional - Número de registros (1-500, default: 20)"
        },
        "ejemplo_respuesta": [
          {
            "position_id": 1,
            "ts": "2024-01-15 10:30:00",
            "bus_id": 1,
            "speed_kmh": 45.5,
            "distance_to_next_stop_m": 150,
            "bus_code": "BUS_TRANSMETRO"
          },
          {
            "position_id": 2,
            "ts": "2024-01-15 10:29:30",
            "bus_id": 2,
            "speed_kmh": 38.2,
            "distance_to_next_stop_m": 200,
            "bus_code": "BUS_TRANSURBANO"
          }
        ]
      },

      "gas_history": {
        "url": "GET /api/v1/data/gas-history",
        "descripcion": "Historial de mediciones de gas",
        "parametros": {
          "from_ts": "opcional - Fecha inicio (YYYY-MM-DD HH:MM:SS)",
          "to_ts": "opcional - Fecha fin (YYYY-MM-DD HH:MM:SS)",
          "limit": "opcional - Número de registros (1-2000, default: 100)"
        },
        "ejemplo_respuesta": [
          {
            "gas_id": 1,
            "ts": "2024-01-15 10:30:00",
            "ppm": 25.3
          },
          {
            "gas_id": 2,
            "ts": "2024-01-15 10:29:30",
            "ppm": 22.1
          },
          {
            "gas_id": 3,
            "ts": "2024-01-15 10:29:00",
            "ppm": 20.5
          }
        ]
      },

      "seismic_history": {
        "url": "GET /api/v1/data/seismic-history",
        "descripcion": "Historial de mediciones sísmicas",
        "ejemplo_respuesta": [
          {
            "seis_id": 1,
            "ts": "2024-01-15 10:30:00",
            "intensity_g": 0.1
          },
          {
            "seis_id": 2,
            "ts": "2024-01-15 10:29:30",
            "intensity_g": 0.08
          },
          {
            "seis_id": 3,
            "ts": "2024-01-15 10:29:00",
            "intensity_g": 0.05
          }
        ]
      },

      "traffic_infractions": {
        "url": "GET /api/v1/data/tables/traffic-infractions",
        "descripcion": "Infracciones de tráfico",
        "ejemplo_respuesta": [
          {
            "alert_id": 1,
            "signal_color": "red"
          },
          {
            "alert_id": 2,
            "signal_color": "yellow"
          }
        ]
      },

      "panic_events": {
        "url": "GET /api/v1/data/tables/panic-events",
        "descripcion": "Eventos de botón de pánico",
        "ejemplo_respuesta": [
          {
            "alert_id": 3,
            "button_id": 1
          },
          {
            "alert_id": 4,
            "button_id": 2
          }
        ]
      },

      "seismic_events": {
        "url": "GET /api/v1/data/tables/seismic-events",
        "descripcion": "Eventos sísmicos",
        "ejemplo_respuesta": [
          {
            "alert_id": 5,
            "intensity_g": 0.15,
            "duration_ms": 2500
          }
        ]
      },

      "gas_events": {
        "url": "GET /api/v1/data/tables/gas-events",
        "descripcion": "Eventos de gas",
        "ejemplo_respuesta": [
          {
            "alert_id": 6,
            "ppm": 150.5,
            "threshold_ppm": 100.0
          }
        ]
      }
    },

