{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ejecutar Processing Sketch",
            "type": "shell",
            "command": "processing-java",
            "args": [
                "--sketch=.",
                "--run"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Compilar Processing Sketch",
            "type": "shell",
            "command": "processing-java",
            "args": [
                "--sketch=.",
                "--build=./build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Exportar Processing App",
            "type": "shell",
            "command": "processing-java",
            "args": [
                "--sketch=.",
                "--export"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
