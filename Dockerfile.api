# Dockerfile para el API FastAPI
FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements y instalar dependencias Python
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código del API
COPY api/ .

# Copiar archivos SQL y script de inicialización
COPY SQL/ /app/SQL/
COPY init-db.py /app/

# Crear directorio para la base de datos
RUN mkdir -p /app/data

# Exponer puerto
EXPOSE 8001

# Script de inicio que inicializa la BD y ejecuta la app
COPY start-api.sh /app/
RUN chmod +x /app/start-api.sh

CMD ["/app/start-api.sh"]
