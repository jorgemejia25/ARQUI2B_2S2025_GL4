# Configuración MQTT
MQTT_BROKER_HOST=192.168.1.16
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=arduino_publisher
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Topics MQTT
MQTT_TOPIC_DATA=arduino/data
MQTT_TOPIC_STATUS=arduino/status
MQTT_TOPIC_COMMANDS=arduino/commands

# Configuración Serial Arduino
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1.0

# Configuración API
API_HOST=0.0.0.0
API_PORT=8001

# Configuración de Logging
LOG_LEVEL=INFO
LOG_FILE=mqtt_logs/app.log

# Configuración de Reconexión
MQTT_AUTO_RECONNECT=true
MQTT_MAX_RECONNECT_ATTEMPTS=5
MQTT_RECONNECT_DELAY=2.0

# Configuración de Procesamiento de Datos
DATA_READ_INTERVAL=0.1
DATA_ENCODING=utf-8
DATA_MAX_BUFFER_SIZE=1024
